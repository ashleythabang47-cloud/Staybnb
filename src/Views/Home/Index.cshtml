@model Staybnb.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Find your next stay";
}

<div class="mb-4">
    <h1 class="h3">Relax. Unwind. Choose your next stay.</h1>
</div>

<form method="get" asp-controller="Home" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-4">
        <select name="city" class="form-select">
            <option value="">Anywhere (all cities)</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c" selected="@(Model.City == c)">@c</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <select name="type" class="form-select">
            <option value="">Any property type</option>
            @foreach (var t in Staybnb.ViewModels.HostApplicationViewModel.PropertyTypes)
            {
                <option value="@t" selected="@(Model.Type == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-danger">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Properties.Any())
{
    <div class="alert alert-light border">No properties match your search yet.</div>
}

<div class="row g-4">
@foreach (var p in Model.Properties)
{
    var image = p.Images.FirstOrDefault();
    var rating = p.Reviews.Any() ? p.Reviews.Average(r => r.Rating) : 0;

    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
        <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">
            <div class="card border-0 h-100">
                @if (image != null)
                {
                    <img src="@image.ImageUrl" alt="@p.Title" class="rounded-3" style="width:100%;height:220px;object-fit:cover" />
                }
                else
                {
                    <div class="rounded-3 bg-light" style="width:100%;height:220px"></div>
                }
                <div class="card-body px-1 pb-0">
                    <div class="d-flex justify-content-between">
                        <div class="fw-semibold">@p.City, South Africa</div>
                        <div class="small"><span class="text-danger">&#9733;</span> @rating.ToString("0.0") (@p.Reviews.Count)</div>
                    </div>
                    <div class="text-muted small">@p.Title</div>
                    <div class="text-muted small">@p.PropertyType &middot; up to @p.MaxGuests guests</div>
                    <div class="mt-1"><span class="fw-semibold">R @p.PricePerNight.ToString("N0")</span> <span class="text-muted small">per night</span></div>
                </div>
            </div>
        </a>
    </div>
}
</div>
