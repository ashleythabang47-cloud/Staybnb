@model Staybnb.ViewModels.PropertyDetailsViewModel
@{
    var p = Model.Property;
    ViewData["Title"] = p.Title;
    var images = p.Images.ToList();
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var tomorrow = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<h1 class="h3 mb-1">@p.Title</h1>
<div class="text-muted mb-3">
    @p.City, South Africa &middot; @p.PropertyType &middot; up to @p.MaxGuests guests &middot;
    <span class="text-danger">&#9733;</span> @Model.AverageRating.ToString("0.0") (@Model.ReviewCount reviews)
    @if (!p.IsActive)
    {
        <span class="badge bg-secondary ms-2">Not visible to guests</span>
    }
</div>

@if (images.Any())
{
    <div class="row g-2 mb-4">
        <div class="col-md-8">
            <img src="@images[0].ImageUrl" alt="@p.Title" class="rounded-3" style="width:100%;height:380px;object-fit:cover" />
        </div>
        <div class="col-md-4">
            <div class="row g-2">
                @foreach (var img in images.Skip(1).Take(2))
                {
                    <div class="col-6 col-md-12">
                        <img src="@img.ImageUrl" alt="@p.Title" class="rounded-3" style="width:100%;height:185px;object-fit:cover" />
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="d-flex align-items-center mb-3">
            <div>
                <div class="fw-semibold">Hosted by @p.Host?.FullName</div>
                <span class="badge bg-danger">Verified Host</span>
            </div>
        </div>
        <hr />

        <h2 class="h5">About this place</h2>
        <p style="white-space:pre-line">@p.Description</p>
        <div class="text-muted small mb-3">@p.Address</div>
        <hr />

        <h2 class="h5">Amenities</h2>
        @if (p.Amenities.Any())
        {
            <div class="row">
                @foreach (var a in p.Amenities)
                {
                    <div class="col-6 mb-1">&bull; @a.Name</div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No amenities listed.</p>
        }
        <hr />

        <h2 class="h5">Reviews</h2>
        @if (!p.Reviews.Any())
        {
            <p class="text-muted">No reviews yet.</p>
        }
        @foreach (var r in p.Reviews.OrderByDescending(r => r.CreatedAt))
        {
            <div class="mb-3">
                <div class="fw-semibold">@r.Reviewer?.FullName <span class="text-danger">@string.Concat(Enumerable.Repeat("★", r.Rating))</span></div>
                <div>@r.Comment</div>
                <div class="small text-muted">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm position-sticky" style="top:1rem">
            <div class="card-body">
                <div class="fs-4 fw-bold">R @p.PricePerNight.ToString("N0") <span class="fs-6 fw-normal text-muted">/ night</span></div>

                @if (User.IsInRole("Guest") && p.IsActive)
                {
                    <form asp-controller="Bookings" asp-action="Create" method="post" id="bookingForm" class="mt-3">
                        <input type="hidden" name="propertyId" value="@p.Id" />
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small mb-0">Check-in</label>
                                <input type="date" name="checkIn" id="checkIn" class="form-control" min="@today" value="@today" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-0">Check-out</label>
                                <input type="date" name="checkOut" id="checkOut" class="form-control" min="@tomorrow" value="@tomorrow" required />
                            </div>
                        </div>
                        <div class="mt-2">
                            <label class="form-label small mb-0">Guests (max @p.MaxGuests)</label>
                            <input type="number" name="guests" class="form-control" min="1" max="@p.MaxGuests" value="1" required />
                        </div>

                        <div id="quoteMessage" class="text-danger small mt-2"></div>
                        <div id="quoteBox" class="mt-3 small" style="display:none">
                            <div class="d-flex justify-content-between"><span id="qNights"></span><span id="qSubtotal"></span></div>
                            <div class="d-flex justify-content-between"><span>Cleaning fee</span><span id="qCleaning"></span></div>
                            <div class="d-flex justify-content-between"><span>Service fee</span><span id="qService"></span></div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between fw-bold"><span>Total</span><span id="qTotal"></span></div>
                        </div>

                        <button type="submit" id="bookButton" class="btn btn-danger w-100 mt-3">Request to book</button>
                        <div class="text-muted small text-center mt-2">You won't be charged until the host approves.</div>
                    </form>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <p class="text-muted mt-3">Log in as a guest to request this stay.</p>
                    <a class="btn btn-danger w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Log in to book</a>
                }
                else
                {
                    <p class="text-muted mt-3 mb-0">Only guest accounts can book a stay.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (User.IsInRole("Guest") && p.IsActive)
    {
        <script>
            (function () {
                var propertyId = @p.Id;
                var checkIn = document.getElementById('checkIn');
                var checkOut = document.getElementById('checkOut');
                var box = document.getElementById('quoteBox');
                var msg = document.getElementById('quoteMessage');
                var button = document.getElementById('bookButton');

                function money(n) {
                    return 'R ' + Number(n).toLocaleString('en-ZA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }

                function update() {
                    if (!checkIn.value || !checkOut.value) { return; }

                    fetch('/Properties/Quote?id=' + propertyId + '&checkIn=' + checkIn.value + '&checkOut=' + checkOut.value)
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            msg.textContent = d.message || '';
                            if (d.nights >= 1) {
                                document.getElementById('qNights').textContent = money(d.pricePerNight) + ' x ' + d.nights + ' night(s)';
                                document.getElementById('qSubtotal').textContent = money(d.subtotal);
                                document.getElementById('qCleaning').textContent = money(d.cleaningFee);
                                document.getElementById('qService').textContent = money(d.serviceFee);
                                document.getElementById('qTotal').textContent = money(d.total);
                                box.style.display = 'block';
                            } else {
                                box.style.display = 'none';
                            }
                            button.disabled = !d.valid;
                        });
                }

                checkIn.addEventListener('change', function () {
                    var next = new Date(checkIn.value);
                    next.setDate(next.getDate() + 1);
                    var iso = next.toISOString().split('T')[0];
                    checkOut.min = iso;
                    if (checkOut.value <= checkIn.value) { checkOut.value = iso; }
                    update();
                });
                checkOut.addEventListener('change', update);
                update();
            })();
        </script>
    }
}
