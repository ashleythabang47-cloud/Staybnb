@model Staybnb.ViewModels.CheckInSetupViewModel
@{
    ViewData["Title"] = "Check-in Process";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="h3 mb-1">Check-in process</h1>
        <p class="text-muted">Property: <strong>@Model.PropertyTitle</strong>. Guests with an approved booking follow these steps and upload the documents you require.</p>

        <form asp-controller="Host" asp-action="ConfigureCheckIn" method="post">
            <input type="hidden" asp-for="PropertyId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rules" class="form-label"></label>
                <textarea asp-for="Rules" class="form-control" rows="5" placeholder="No smoking indoors&#10;Quiet hours start at 22:00&#10;Check-out by 10:00"></textarea>
            </div>

            <div class="mb-4">
                <label asp-for="Documents" class="form-label"></label>
                <textarea asp-for="Documents" class="form-control" rows="3" placeholder="ID or Passport"></textarea>
                <div class="form-text">If you leave this empty, "ID or Passport" is required by default.</div>
            </div>

            <button type="submit" class="btn btn-danger">Save check-in process</button>
            <a class="btn btn-outline-secondary" asp-action="Properties">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
