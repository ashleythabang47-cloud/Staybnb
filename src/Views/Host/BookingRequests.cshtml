@model List<Staybnb.Models.Booking>
@using Staybnb.Models.Enums
@{
    ViewData["Title"] = "Booking Requests";
    var current = ViewData["CurrentStatus"]?.ToString() ?? "All";
}

<h1 class="h3 mb-3">Booking Requests</h1>

<ul class="nav nav-pills mb-3">
    @foreach (var tab in new[] { "All", "Pending", "Approved", "Rejected", "CheckedIn", "Cancelled" })
    {
        <li class="nav-item">
            <a class="nav-link @(current == tab ? "active bg-danger" : "text-dark")"
               asp-action="BookingRequests" asp-route-status="@(tab == "All" ? null : tab)">@tab</a>
        </li>
    }
</ul>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th>Guest</th><th>Property</th><th>Dates</th><th>Guests</th><th>Total</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Guest?.FullName<br /><span class="small text-muted">@b.Guest?.Email</span></td>
                <td>@b.Property?.Title</td>
                <td>@b.CheckInDate.ToString("dd MMM") to @b.CheckOutDate.ToString("dd MMM yyyy")</td>
                <td>@b.NumberOfGuests</td>
                <td>R @b.TotalPrice.ToString("N2")<br />
                    <span class="small text-muted">Payment: @(b.Payment?.Status.ToString() ?? "n/a")</span></td>
                <td>
                    @switch (b.Status)
                    {
                        case BookingStatus.Approved:
                            <span class="badge bg-success">Approved</span>
                            break;
                        case BookingStatus.Rejected:
                            <span class="badge bg-danger">Rejected</span>
                            break;
                        case BookingStatus.CheckedIn:
                            <span class="badge bg-primary">Checked in</span>
                            break;
                        case BookingStatus.Cancelled:
                            <span class="badge bg-secondary">Cancelled</span>
                            break;
                        case BookingStatus.Completed:
                            <span class="badge bg-dark">Completed</span>
                            break;
                        default:
                            <span class="badge bg-warning text-dark">Pending</span>
                            break;
                    }
                </td>
                <td class="text-end text-nowrap">
                    @if (b.Status == BookingStatus.Pending)
                    {
                        <form asp-action="ApproveBooking" asp-route-id="@b.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form asp-action="RejectBooking" asp-route-id="@b.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Reject this booking request?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted py-4">No booking requests found.</td></tr>
        }
        </tbody>
    </table>
</div>
