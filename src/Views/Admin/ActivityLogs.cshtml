@model Staybnb.ViewModels.ActivityLogsViewModel
@using Staybnb.Models.Enums
@{
    ViewData["Title"] = "Activity Logs";
}

<h1 class="h3 mb-1">Activity Logs</h1>
<p class="text-muted">Security actions and significant system events (@Model.TotalCount total).</p>

<form method="get" asp-action="ActivityLogs" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="">All types</option>
            @foreach (var name in Enum.GetNames(typeof(ActivityType)))
            {
                <option value="@name" selected="@(Model.Type == name)">@name</option>
            }
        </select>
    </div>
    <div class="col-md-5">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search action or user email" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-dark">Filter</button>
        <a asp-action="ActivityLogs" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Date</th><th>User</th><th>Action</th><th>Type</th></tr>
        </thead>
        <tbody>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td class="text-nowrap">@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@(log.User?.Email ?? "system")</td>
                <td>@log.Action</td>
                <td><span class="badge bg-light text-dark border">@log.ActivityType</span></td>
            </tr>
        }
        @if (!Model.Logs.Any())
        {
            <tr><td colspan="4" class="text-center text-muted py-4">No activity found.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="ActivityLogs" asp-route-page="@(Model.Page - 1)"
                   asp-route-type="@Model.Type" asp-route-search="@Model.Search">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="ActivityLogs" asp-route-page="@(Model.Page + 1)"
                   asp-route-type="@Model.Type" asp-route-search="@Model.Search">Next</a>
            </li>
        </ul>
    </nav>
}
