@model List<Staybnb.Models.HostApplication>
@using Staybnb.Models.Enums
@{
    ViewData["Title"] = "Host Application Status";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Host Application Status</h1>
    <a class="btn btn-danger" asp-controller="HostApplications" asp-action="Create">New application</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">You have not applied to become a host yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Property</th>
                    <th>City</th>
                    <th>Price / night</th>
                    <th>Applied</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var app in Model)
            {
                var image = app.Property?.Images.FirstOrDefault();
                <tr>
                    <td style="width:90px">
                        @if (image != null)
                        {
                            <img src="@image.ImageUrl" alt="@app.Property?.Title" class="img-thumbnail" style="width:80px;height:60px;object-fit:cover" />
                        }
                    </td>
                    <td>@app.Property?.Title</td>
                    <td>@app.Property?.City</td>
                    <td>R @app.Property?.PricePerNight.ToString("N2")</td>
                    <td>@app.AppliedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @switch (app.Status)
                        {
                            case ApplicationStatus.Approved:
                                <span class="badge bg-success">Approved</span>
                                break;
                            case ApplicationStatus.Rejected:
                                <span class="badge bg-danger">Rejected</span>
                                break;
                            default:
                                <span class="badge bg-warning text-dark">Pending</span>
                                break;
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
