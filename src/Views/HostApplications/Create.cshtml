@model Staybnb.ViewModels.HostApplicationViewModel
@{
    ViewData["Title"] = "Become a Host";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-1">Become a Host</h1>
        <p class="text-muted">Tell us about your property. An administrator reviews every application before it goes live.</p>

        <form asp-controller="HostApplications" asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Cozy Forest Cabin" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PropertyType" class="form-label"></label>
                    <select asp-for="PropertyType" class="form-select">
                        <option value="">Select a type</option>
                        @foreach (var type in Staybnb.ViewModels.HostApplicationViewModel.PropertyTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                    <span asp-validation-for="PropertyType" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MaxGuests" class="form-label"></label>
                    <input asp-for="MaxGuests" class="form-control" type="number" min="1" />
                    <span asp-validation-for="MaxGuests" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PricePerNight" class="form-label"></label>
                    <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" min="1" />
                    <span asp-validation-for="PricePerNight" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CleaningFee" class="form-label"></label>
                    <input asp-for="CleaningFee" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="CleaningFee" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Amenities</label>
                <div class="row">
                    @foreach (var amenity in Model.AvailableAmenities)
                    {
                        <div class="col-6 col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedAmenityIds"
                                       value="@amenity.Id" id="amenity-@amenity.Id"
                                       checked="@Model.SelectedAmenityIds.Contains(amenity.Id)" />
                                <label class="form-check-label" for="amenity-@amenity.Id">@amenity.Name</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-4">
                <label for="images" class="form-label">Property images <span class="text-danger">*</span></label>
                <input type="file" id="images" name="images" class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" multiple required />
                <div class="form-text">At least one image is required (JPG, PNG or WEBP, up to 5 MB each).</div>
                <span class="text-danger field-validation-valid" data-valmsg-for="images" data-valmsg-replace="true"></span>
                @if (ViewData.ModelState.TryGetValue("images", out var imageState) && imageState.Errors.Count > 0)
                {
                    foreach (var error in imageState.Errors)
                    {
                        <div class="text-danger">@error.ErrorMessage</div>
                    }
                }
            </div>

            <button type="submit" class="btn btn-danger">Submit application</button>
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
