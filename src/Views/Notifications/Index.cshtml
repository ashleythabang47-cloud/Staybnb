@model Staybnb.ViewModels.NotificationsViewModel
@using Staybnb.Models.Enums
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Notifications
        @if (Model.UnreadCount > 0)
        {
            <span class="badge bg-danger fs-6">@Model.UnreadCount new</span>
        }
    </h1>
    @if (Model.UnreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            <button type="submit" class="btn btn-outline-dark btn-sm">Mark all read</button>
        </form>
    }
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(Model.Filter == "all" ? "active bg-dark" : "text-dark")" asp-action="Index" asp-route-filter="all">All (@Model.TotalCount)</a></li>
    <li class="nav-item"><a class="nav-link @(Model.Filter == "unread" ? "active bg-dark" : "text-dark")" asp-action="Index" asp-route-filter="unread">Unread (@Model.UnreadCount)</a></li>
    <li class="nav-item"><a class="nav-link @(Model.Filter == "read" ? "active bg-dark" : "text-dark")" asp-action="Index" asp-route-filter="read">Read (@Model.ReadCount)</a></li>
</ul>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="list-group">
        @foreach (var n in Model.Items)
        {
            var isSelected = Model.Selected != null && Model.Selected.Id == n.Id;
            <a asp-action="Index" asp-route-selectedId="@n.Id" asp-route-filter="@Model.Filter"
               class="list-group-item list-group-item-action @(isSelected ? "active" : "") @(!n.IsRead ? "border-start border-danger border-4" : "")">
                <div class="d-flex justify-content-between">
                    <span class="@(!n.IsRead ? "fw-bold" : "")">@n.Title</span>
                    <small>@n.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</small>
                </div>
                <div class="small @(isSelected ? "" : "text-muted") text-truncate">@n.Message</div>
            </a>
        }
        @if (!Model.Items.Any())
        {
            <div class="list-group-item text-center text-muted py-4">No notifications here.</div>
        }
        </div>
    </div>

    <div class="col-lg-7">
        @if (Model.Selected != null)
        {
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h2 class="h5">@Model.Selected.Title</h2>
                        <span class="badge bg-light text-dark border">@(Model.Selected.IsRead ? "Read" : "Unread")</span>
                    </div>
                    <div class="small text-muted mb-3">@Model.Selected.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm") &middot; @Model.Selected.Type</div>
                    <p>@Model.Selected.Message</p>

                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(Model.SelectedActionUrl))
                        {
                            <a class="btn btn-danger btn-sm" href="@Model.SelectedActionUrl">Take Action</a>
                        }
                        <form asp-action="Delete" asp-route-id="@Model.Selected.Id" method="post">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-muted pt-4 text-center">Select a notification to read it.</div>
        }
    </div>
</div>
